#!name = Chase ITIN Fix
#!desc = 拦截 Chase 开户请求，将 SSN 字段自动替换为 ITIN(TIN)，允许持 ITIN 的用户在线完成 Chase 账户注册。
#!system = ios, mac
#!category = Finance

[Script]
Chase ITIN Fix = type=http-request,pattern=https://secure\.chase\.com/svc/wl/auth/public/v4/user/enrollment/form/list,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/devinqiu888/USBANKS-rules/refs/heads/main/chase-itin.js

[MITM]
hostname = %APPEND% secure.chase.com
